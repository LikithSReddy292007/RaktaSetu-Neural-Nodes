# RakthaSetu Backend Environment Configuration

PORT=5000
NODE_ENV=development
CORS_ORIGIN=*

# Firebase Service Account Credentials (Optional for local dev, Required for Production Cloud Firestore/Auth)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://your-firebase-project-id-default-rtdb.firebaseio.com

# Agora RTC Voice & Video Calling Credentials (Optional for local dev, Required for Live Agora Calling)
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate
