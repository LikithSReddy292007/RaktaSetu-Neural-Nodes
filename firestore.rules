rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Blood Requests Collection
    match /blood_requests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.user_id == request.auth.uid ||
        isAdmin() ||
        // Allow a verified donor to accept a pending/matching request
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'accepted_donor_id', 'updated_at']) &&
         request.resource.data.status in ['accepted', 'in_progress'])
      );
      allow delete: if isAuthenticated() && (resource.data.user_id == request.auth.uid || isAdmin());
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.user_id == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.user_id == request.auth.uid &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if isAdmin();
    }

    // Donation History
    match /donation_history/{historyId} {
      allow read: if isAuthenticated() && (
        resource.data.donor_id == request.auth.uid ||
        isAdmin()
      );
      allow write: if isAdmin();
    }

    // Admin Logs and Reports
    match /admin_logs/{logId} {
      allow read, write: if isAdmin();
    }

    match /reports/{reportId} {
      allow create: if isAuthenticated();
      allow read, write: if isAdmin();
    }
  }
}

